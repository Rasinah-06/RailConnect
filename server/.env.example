PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/railconnect
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Seat hold (like IRCTC payment window), minutes
HOLD_MINUTES=5
# Max waiting list per class per train run
WL_CAP=25
# How far ahead tickets open (kept configurable)
ADVANCE_DAYS=60
# true = enforce Tatkal booking windows (AC 10:00, Sleeper 11:00 the day before)
ENFORCE_TATKAL_WINDOW=false

# true = skip installing MongoDB and use a temporary in-memory database (data resets on restart).
# If MongoDB is not reachable, the server falls back to this automatically.
USE_MEMORY_DB=false
